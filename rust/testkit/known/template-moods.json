    "xml": "<glyph-package engine=\"3.6.9.07\">\n  <schema/>\n  <block once=\"true\">\n    <mood dominant=\"enthusiasm\"/>\n    <template name=\"reinforce\" expanded=\"true\" means=\"There is a must-follow rule. Raise its precedence and state why it holds, so it survives a long context.\">\n      <priority imperative=\"true\">\n        <mandatory>\n          <user-input slot=\"rule\">a</user-input>\n        </mandatory>\n      </priority>\n      <reason>\n        <user-input slot=\"why\">b</user-input>\n      </reason>\n    </template>\n  </block>\n</glyph-package>",

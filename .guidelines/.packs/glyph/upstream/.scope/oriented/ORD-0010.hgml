[block
  'linkedin-post'
  [ctx
    'a post carrying one observation the author already had'
    'any social feed written in a second language'
    'filled by the Regente before drafting'
  [/ctx]
  [skl
    'glyph-markup'
    [ins
      'hear this order, draft the post, then audit and reflect before concluding it'
    [/ins]
  [/skl]
  [section
    'species'
    [dfn
      'observation'
      'something the author noticed and can state in one sentence — the whole payload of the post'
    [/dfn]
    [dfn
      'framework'
      'a method other people are expected to adopt — what an observation turns into when the writer inflates it'
    [/dfn]
    [dfn
      'import'
      'a claim the writer added that the author never made, arriving as a paragraph that reads well and holds nothing the author said'
    [/dfn]
    [dfn
      'cold read'
      'reading the draft as someone meeting the subject for the first time, with no access to the conversation that produced it'
    [/dfn]
    [dfn
      'load-bearing phrase'
      'a phrase the whole point rests on, doing that work with no example beside it'
    [/dfn]
    [nt
      'the author writes to be read once, not to be followed'
    [/nt]
    [dont
      'promote an observation to a framework because a framework is easier to structure'
    [/dont]
  [/section]
  [section
    'write'
    [dfn
      'the reader leaves holding one word or one distinction, and nothing to adopt'
      [tgt
        [rsn[/rsn]
      [/tgt]
    [/dfn]
    [ph
      [observation[/observation]
      'the observation, in one sentence, as the author stated it and not as it could be generalised'
    [/ph]
    [ph
      [annoyance[/annoyance]
      'the concrete annoyance that produced it — what went wrong, how often, at whose cost'
    [/ph]
    [ph
      [tone[/tone]
      'the register the opening sets, stated as what the author would actually say out loud'
    [/ph]
    [req
      'every claim in the draft traces to something the author said'
    [/req]
    [fmt
      'running prose, no headers, no numbered framework, no call to action'
    [/fmt]
    [lim
      'the draft may be dense, and density is not the same as structure'
    [/lim]
    [cnst
      'the post stays unpitchable: no problem-solution shape, no scaling claim, no before and after'
    [/cnst]
    [nev
      'a paragraph enters the draft to fill a shape the author did not ask for'
    [/nev]
  [/section]
  [section
    'audit'
    [cmp
      'the draft, read cold — start to finish, once, with no prior context assumed'
      [ctx[/ctx]
      [spec
        [core[/core]
      [/spec]
      [real
        [error[/error]
        [core
          [ctx[/ctx]
          [dist
            [skl[/skl]
          [/dist]
        [/core]
      [/real]
      [ref
        [def
          [spec
            [core[/core]
            [ctx[/ctx]
          [/spec]
        [/def]
      [/ref]
    [/cmp]
    [rwk
      'the target itself, corrected by what the critique found'
    [/rwk]
    [cmp
      'the reworked result'
      'a reader who works in this field, meets the subject here for the first time, and gets it without asking a question'
      [ctx[/ctx]
      [cnst[/cnst]
    [/cmp]
    [sub
      [eq
        [cmp
          [ctx[/ctx]
        [/cmp]
      [/eq]
    [/sub]
    [elab
      [eq[/eq]
      [sub[/sub]
      [rsn[/rsn]
    [/elab]
    [ref
      [cnst[/cnst]
    [/ref]
    [ctx[/ctx]
    [core[/core]
    [core[/core]
    [elab[/elab]
    [find
      'every load-bearing phrase standing without an example beside it'
    [/find]
    [warn
      'a load-bearing phrase makes the reader supply the example from personal experience, and a newer reader has none to supply'
    [/warn]
    [dist
      'the closing lines, for a defence against a reading nobody offered'
      [rsn[/rsn]
      [rev
        [find
          [real[/real]
        [/find]
        [whr
          [real
            [eq[/eq]
            [r
              [conf[/conf]
            [/r]
          [/real]
        [/whr]
        [ref
          [tgt[/tgt]
        [/ref]
      [/rev]
      [cmp
        [tgt[/tgt]
        [true
          [fin
            [go
              [logic[/logic]
            [/go]
            [elab
              [core
                [ctx[/ctx]
              [/core]
              [rwk[/rwk]
              [mand
                [neq[/neq]
              [/mand]
              [ctx
                [go
                  [switch[/switch]
                [/go]
              [/ctx]
              [rsn[/rsn]
            [/elab]
            [ref
              [cnst[/cnst]
            [/ref]
          [/fin]
        [/true]
        [true[/true]
      [/cmp]
      [ctx
        [cmp
          [true[/true]
        [/cmp]
        [rsn[/rsn]
      [/ctx]
      [elab
        [ask
          [dist
            [rsn[/rsn]
            [rev
              [real[/real]
              [ref
                [tgt[/tgt]
              [/ref]
            [/rev]
            [cmp
              [tgt[/tgt]
              [true
                [fin
                  [go
                    [logic[/logic]
                  [/go]
                  [elab
                    [core
                      [ctx[/ctx]
                    [/core]
                    [rwk[/rwk]
                    [mand
                      [neq[/neq]
                    [/mand]
                    [ctx
                      [go
                        [switch[/switch]
                      [/go]
                    [/ctx]
                    [rsn[/rsn]
                  [/elab]
                  [ref
                    [cnst[/cnst]
                  [/ref]
                [/fin]
              [/true]
              [true[/true]
            [/cmp]
          [/dist]
        [/ask]
        [sub[/sub]
        [rsn[/rsn]
      [/elab]
      [ref
        [cnst[/cnst]
      [/ref]
      [ctx[/ctx]
      [core[/core]
    [/dist]
    [cmp
      'terminology is consistent across the draft — the same thing named the same way, capitalised the same way, every time'
      [true[/true]
    [/cmp]
    [avd
      'idiom carried over from the first language of the author, and words that only exist in that language'
    [/avd]
    [error
      'a shape an investor can lift: a bottleneck being fixed, a thing that scales, a state before and a state after'
      [ctx[/ctx]
    [/error]
    [nt
      'the audit reports; it does not rewrite'
    [/nt]
  [/section]
  [section
    'reflect'
    [itr
      'each paragraph, against what the author actually stated'
    [/itr]
    [ins
      'one more import named and cut, going finer than the pass before — a whole thesis first, then a clause, then a single adjective doing the same work'
    [/ins]
    [cond
      'every paragraph traces to the author, and no paragraph needs a claim the author did not make in order to hold together'
    [/cond]
    [real
      'each pass against the stop condition, before opening the next one'
    [/real]
    [dist
      'what the author stated'
      'what the writer added and then read back as if it had been stated'
    [/dist]
    [warn
      'if a paragraph collapses once an unstated claim is removed, that claim was imported and the paragraph was built on it'
    [/warn]
    [prio
      [mand
        'a correction from the author is authoritative and settles it — reread the chain before defending the sentence'
      [/mand]
    [/prio]
    [rsn
      'the writer is the one who lost the thread, and defending the sentence spends the turn that should have fixed it'
    [/rsn]
    [cnst
      'an import is cut, never softened into a hedge that keeps it in the draft'
    [/cnst]
    [ctx
      'this post, and the next one the author writes on the same subject'
    [/ctx]
    [elab
      'each import found, and which paragraph carried it'
      [rwk[/rwk]
      [mand
        [neq[/neq]
      [/mand]
      [ctx
        [go
          [switch[/switch]
        [/go]
      [/ctx]
      [rsn[/rsn]
    [/elab]
    [ref
      [cnst[/cnst]
    [/ref]
    [elab
      'the chain: where it entered, what changed it, where it stands now'
    [/elab]
    [elab
      'the imports found here — they arrive the same way next time, as the paragraph that reads best'
      [alw
        [get
          [ctx[/ctx]
        [/get]
      [/alw]
    [/elab]
    [rwk[/rwk]
    [sub
      [ctx[/ctx]
    [/sub]
    [add
      [core[/core]
    [/add]
  [/section]
  [section
    'conclude'
    [get
      [whr
        'the last version the author corrected, never the last version the writer preferred'
      [/whr]
    [/get]
    [fin
      'on the open question, with the observation stated once and nothing after it'
    [/fin]
    [dont
      'close with a call to action, a summary of what was just said, or a defence that no system is being sold'
    [/dont]
    [warn
      'a pre-emptive defence tells the reader there was something to suspect'
    [/warn]
    [conf
      'the draft against the author, before it is called finished'
      [hmn[/hmn]
    [/conf]
    [rdy
      'the post ships as prose the author can paste, and not as a document'
    [/rdy]
  [/section]
[/block]
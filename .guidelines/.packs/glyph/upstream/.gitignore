# Obsidian editor state — local, not project content
.obsidian/

# Per-machine Claude Code state: accumulates whatever a session happened to
# run, so it is the file that would eventually carry something local into a
# public history. The durable, shareable rules live in .claude/settings.json.
.claude/settings.local.json

# The skill is generated by build-skill.js and zipped by glyph-zip.js; a zip in
# the working area is a build artefact, never the source of anything.
.scope/**/*.zip

# The Rust workspace's build output
rust/target/

# .guidelines/.shortcuts/.virtual/ holds the virtual-path index glyph-vpath
# writes; the regency plugin keeps its own session state beside it (journal,
# lineage fingerprints), which is local and never project content
.guidelines/.shortcuts/.virtual/*
!.guidelines/.shortcuts/.virtual/index.json
!.guidelines/.shortcuts/.virtual/ongoing.json
!.guidelines/.shortcuts/.virtual/README.md

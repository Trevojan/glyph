<glyph-package engine="3.5.8.06">
  <schema/>
  <block once="true">
    <block binds="ORD-0003-vocabulary">
      <user-input>ORD-0003-vocabulary</user-input>
      <context>
        <user-input>the spec of EMS-001</user-input>
        <user-input>.guidelines/.orders/EMS-001/EMS-001.pgml</user-input>
      </context>
      <only-if>
        <user-input>ORD-0002 closed</user-input>
      </only-if>
      <target>
        <user-input>glyph-vocab and glyph-stores: build.rs turns the four sources build-templates.js reads into tables, and the context object is a struct passed by reference</user-input>
      </target>
      <validate>
        <invoke reads="[CMP-CTX[CNST]][SUB[EQ[CMP-CTX]]][CAT-EQ]" species="composite" depth="5"/>
        <user-input>the generated tables</user-input>
        <user-input>the digest of every generated table equals the JS store</user-input>
      </validate>
    </block>
  </block>
</glyph-package>
[block
  'ORD-0004-order'
  [ctx
    'the spec of EMS-002'
    '.guidelines/.orders/EMS-002/EMS-002.pgml'
  [/ctx]
  [onlyif
    'ORD-0003 closed'
  [/onlyif]
  [tgt
    'glyph-vpath: order maintenance, layer 3 of .plan section 0, as order queries over the positions the index holds'
  [/tgt]
  [cnst
    'the order is the index own: files in the order the index lists them, then nodes by start, the one that holds the other first; it is computed once on load, and nothing new is stored'
  [/cnst]
  [cnst
    'above answers the nodes of the same file that end where a node starts or before, nearest first; between answers every node from one reference to the other in order, across files'
  [/cnst]
  [cnst
    'a reference is a virtual path, an alias, a recovery or a NodeID, read as resolve reads it, and one the index does not hold is refused'
  [/cnst]
  [nev
    'stable positions in the index, order labels by Dietz–Sleator and relative offsets: they would hold 42.0 percent of the rows an edit rewrites, under the 50 percent declared, INTAKE-VIRTUAL-PATH section 25'
  [/nev]
  [cmp
    'before'
    'for any two references, before answers which comes first, or that one holds the other, in constant time'
    [ctx[/ctx]
    [cnst[/cnst]
  [/cmp]
  [sub
    [eq
      [cmp
        [ctx[/ctx]
      [/cmp]
    [/eq]
  [/sub]
  [elab
    [eq[/eq]
    [sub[/sub]
    [rsn[/rsn]
  [/elab]
  [ref
    [cnst[/cnst]
  [/ref]
  [ctx[/ctx]
  [core[/core]
  [core[/core]
  [elab[/elab]
  [cmp
    'above and between'
    'above answers what precedes a node in its file, nearest first, and between the nodes from one reference to another in order, each by a search in logarithmic time; between refuses when the second comes first'
    [ctx[/ctx]
    [cnst[/cnst]
  [/cmp]
  [sub
    [eq
      [cmp
        [ctx[/ctx]
      [/cmp]
    [/eq]
  [/sub]
  [elab
    [eq[/eq]
    [sub[/sub]
    [rsn[/rsn]
  [/elab]
  [ref
    [cnst[/cnst]
  [/ref]
  [ctx[/ctx]
  [core[/core]
  [core[/core]
  [elab[/elab]
  [cmp
    'the order'
    'the order agrees with the files and offsets of the index on every pair of the repository, and answers right after a node is inserted, moved or removed'
    [ctx[/ctx]
    [cnst[/cnst]
  [/cmp]
  [sub
    [eq
      [cmp
        [ctx[/ctx]
      [/cmp]
    [/eq]
  [/sub]
  [elab
    [eq[/eq]
    [sub[/sub]
    [rsn[/rsn]
  [/elab]
  [ref
    [cnst[/cnst]
  [/ref]
  [ctx[/ctx]
  [core[/core]
  [core[/core]
  [elab[/elab]
[/block]
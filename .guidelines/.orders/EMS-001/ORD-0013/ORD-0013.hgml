[block
  'ORD-0013-installer'
  [ctx
    'the spec of EMS-001'
    '.guidelines/.orders/EMS-001/EMS-001.pgml'
  [/ctx]
  [onlyif
    'ORD-0011 closed'
    'ORD-0012 closed'
  [/onlyif]
  [tgt
    'an installer for Windows that puts the binary and the page on a clean machine'
  [/tgt]
  [cnst
    'a simple .msi first; its performance is later work, as the Regent answered on 2026-11-03'
  [/cnst]
  [cnst
    'ADR B as signed: the installed app carries node and serve-dev.js, which serves the page and relays POST /engine to glyph-engine'
  [/cnst]
  [ins
    'measure every installer path against the filter before choosing one'
  [/ins]
  [cmp
    'the installer'
    'a clean machine installs, opens the app and emits an Order'
    [ctx[/ctx]
    [cnst[/cnst]
  [/cmp]
  [sub
    [eq
      [cmp
        [ctx[/ctx]
      [/cmp]
    [/eq]
  [/sub]
  [elab
    [eq[/eq]
    [sub[/sub]
    [rsn[/rsn]
  [/elab]
  [ref
    [cnst[/cnst]
  [/ref]
  [ctx[/ctx]
  [core[/core]
  [core[/core]
  [elab[/elab]
[/block]
[block
  'ORD-0044-pin-vocabulary'
  [ref
    'EMS'
  [/ref]
  [ctx
    'the measured proposal and the answers of the Regent'
    '.guidelines/.orders/INTAKE-PIN-TRAFFIC.md, sections 1, 5, 6 and 8'
  [/ctx]
  [tgt
    'step 6 of the trail to the final Explorer: PIN enters the vocabulary, one command whose chained operand chooses its form, and one element, in both engines'
  [/tgt]
  [ins
    'enter PIN in GLOSSARY.md and expansions.txt first, an atom in the Frame category beside SECTION, BLOCK and PT'
  [/ins]
  [ins
    'read if, else and case chained straight after PIN as its form, words of its own valid only there, the way a hole takes its name'
  [/ins]
  [ins
    'emit one element, pin form if with alias, pin form case with value, pin form else, and pin type for any other command chained to it, and read each back'
  [/ins]
  [cnst
    'else and case outside a PIN stay outside the vocabulary; the selector and its tooltip wait for step 7'
  [/cnst]
  [cnst
    'the ast hashes of the snapshot move with the checksum of the expansions store, by decision, and no xml and no hgml hash moves'
  [/cnst]
  [cnst
    'npm run check and npm run check:rust green'
  [/cnst]
  [cmp
    'the engines'
    'each form emitted, read back from the XML and from the AST, and burnt to a reread that asks nothing, in the Rust as in the JS, seen failing before the code'
    [ctx[/ctx]
    [cnst[/cnst]
  [/cmp]
  [sub
    [eq
      [cmp
        [ctx[/ctx]
      [/cmp]
    [/eq]
  [/sub]
  [elab
    [eq[/eq]
    [sub[/sub]
    [rsn[/rsn]
  [/elab]
  [ref
    [cnst[/cnst]
  [/ref]
  [ctx[/ctx]
  [core[/core]
  [core[/core]
  [elab[/elab]
[/block]